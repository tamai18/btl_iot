# ============================================================================
#  Cấu hình môi trường – Backend Flask
#  Đổi tên file này thành .env (copy .env.example -> .env)
# ============================================================================

# Database
# Để mysql để ưu tiên MySQL; nếu không kết nối được, backend tự dùng SQLite.
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=iot_ao_nuoi
DB_USER=root
DB_PASS=your_mysql_password

# MQTT Broker (Dùng 127.0.0.1 nếu chạy Mosquitto trên máy tính, hoặc đổi thành IP LAN)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=esp32
MQTT_PASS=esp32pass
MQTT_TOPIC_PREFIX=iot
MQTT_DEVICE_HOST=192.168.1.100

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change_this_secret_key_in_production

# Cấu hình Cảnh báo Email (Gmail SMTP hoặc SMTP bất kỳ)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM_NAME=Hệ thống IoT Ao Nuôi
MAIL_ENABLED=true

# Thông số quy tắc cảnh báo & chống spam
NOTIFY_ESP_OFFLINE_SECONDS=120
NOTIFY_STARTUP_GRACE_SECONDS=60
NOTIFY_REMIND_DANGER_MIN=30
NOTIFY_REMIND_WARNING_MIN=120
NOTIFY_MAX_REMINDERS=3
NOTIFY_HOURLY_LIMIT=10

# Phân tích xu hướng & Dự báo mực nước
DEMO_INSIGHTS=false
